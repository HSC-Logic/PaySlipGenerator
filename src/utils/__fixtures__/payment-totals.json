{
  "description": "Shared by the frontend Vitest suite (src/utils/currency.ts) and API.Tests (Slipy.Core PaymentTotals). Expected values were produced by calculatePaymentTotals. Empty strings stand for the editor's empty inputs.",
  "cases": [
    {
      "name": "two lines, no adjustments",
      "items": [
        {
          "quantity": 2,
          "rate": 1500
        },
        {
          "quantity": 1,
          "rate": 500
        }
      ],
      "adjustment": 0,
      "adjustments": [],
      "expected": {
        "itemAmounts": [
          3000,
          500
        ],
        "subtotal": 3500,
        "adjustmentAmounts": [],
        "final": 3500
      }
    },
    {
      "name": "positive manual adjustment",
      "items": [
        {
          "quantity": 2,
          "rate": 1500
        },
        {
          "quantity": 1,
          "rate": 500
        }
      ],
      "adjustment": 500,
      "adjustments": [],
      "expected": {
        "itemAmounts": [
          3000,
          500
        ],
        "subtotal": 3500,
        "adjustmentAmounts": [],
        "final": 4000
      }
    },
    {
      "name": "negative manual adjustment",
      "items": [
        {
          "quantity": 2,
          "rate": 1500
        },
        {
          "quantity": 1,
          "rate": 500
        }
      ],
      "adjustment": -250,
      "adjustments": [],
      "expected": {
        "itemAmounts": [
          3000,
          500
        ],
        "subtotal": 3500,
        "adjustmentAmounts": [],
        "final": 3250
      }
    },
    {
      "name": "empty manual adjustment",
      "items": [
        {
          "quantity": 1,
          "rate": 100
        }
      ],
      "adjustment": "",
      "adjustments": [],
      "expected": {
        "itemAmounts": [
          100
        ],
        "subtotal": 100,
        "adjustmentAmounts": [],
        "final": 100
      }
    },
    {
      "name": "percentage discount and tax",
      "items": [
        {
          "quantity": 1,
          "rate": 1000
        }
      ],
      "adjustment": 0,
      "adjustments": [
        {
          "kind": "discount",
          "mode": "percentage",
          "value": 10
        },
        {
          "kind": "tax",
          "mode": "percentage",
          "value": 18
        }
      ],
      "expected": {
        "itemAmounts": [
          1000
        ],
        "subtotal": 1000,
        "adjustmentAmounts": [
          -100,
          180
        ],
        "final": 1080
      }
    },
    {
      "name": "decimal quantity is rounded to minor units",
      "items": [
        {
          "quantity": 1.5,
          "rate": 19.99
        },
        {
          "quantity": 1,
          "rate": 0.1
        },
        {
          "quantity": 1,
          "rate": 0.2
        }
      ],
      "adjustment": 0,
      "adjustments": [],
      "expected": {
        "itemAmounts": [
          29.99,
          0.1,
          0.2
        ],
        "subtotal": 30.29,
        "adjustmentAmounts": [],
        "final": 30.29
      }
    },
    {
      "name": "percentage adjustment rounds to the nearest minor unit",
      "items": [
        {
          "quantity": 1,
          "rate": 10.01
        }
      ],
      "adjustment": 0.1,
      "adjustments": [
        {
          "kind": "tax",
          "mode": "percentage",
          "value": 17.5
        }
      ],
      "expected": {
        "itemAmounts": [
          10.01
        ],
        "subtotal": 10.01,
        "adjustmentAmounts": [
          1.75
        ],
        "final": 11.86
      }
    },
    {
      "name": "empty quantity and rate count as zero",
      "items": [
        {
          "quantity": "",
